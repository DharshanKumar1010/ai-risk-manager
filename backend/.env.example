# RiskIQ backend configuration — copy to .env and fill in.
#
# .env is gitignored and must never be committed. Every value below is a PLACEHOLDER;
# putting a real credential in this file is the exact failure the secret scan exists to
# catch. See .claude/skills/security-checklist/SKILL.md section 1.

# local | ci | staging | production
ENVIRONMENT=local
DEBUG=false

# --- PostgreSQL --------------------------------------------------------------
# Async driver (asyncpg) is required — a psycopg2 DSN will not work here.
#
# Connect as riskiq_app, never as the riskiq superuser. Superusers and table owners bypass
# row-level security unconditionally, so pointing this at the superuser silently disables
# every isolation policy while leaving them looking correct in the schema.
DATABASE_URL=postgresql+asyncpg://riskiq_app:CHANGE_ME@localhost:5432/riskiq
DATABASE_ECHO=false

# Passwords for the least-privilege roles. Read by infra/postgres-init/10-app-roles.sh when
# the database is first created; the Alembic migration grants LOGIN but sets no password,
# because a credential must never enter tracked source.
RISKIQ_APP_PASSWORD=CHANGE_ME
RISKIQ_PIPELINE_PASSWORD=CHANGE_ME

# DSN Alembic connects with. Migrations create tables, roles, grants and policies — none of
# which riskiq_app may do. Keep this separate so that a failing migration is never "fixed" by
# pointing the application at a superuser, which would disable every RLS policy silently.
MIGRATION_DATABASE_URL=postgresql+asyncpg://riskiq:CHANGE_ME@localhost:5432/riskiq

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Rate limiting. The limiter fails CLOSED: if Redis is unreachable the API returns 503
# rather than admitting unmetered traffic. See .claude/skills/security-checklist item 5.2.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Data --------------------------------------------------------------------
# Root of the dataset tree. Defaults to the repo's data/ directory, so this only needs
# setting when the datasets live elsewhere (a mounted volume, an external drive).
# docker-compose sets this to /data. Contents are gitignored — see data/README.md.
# DATA_DIR=/data
# Where the pipeline writes its data-quality report. docker-compose sets this to /notebooks.
# REPORTS_DIR=/notebooks

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 32 bytes (RFC 7518 section 3.2) — the app refuses to start below that, and
# refuses to start in staging/production while this is still the placeholder value.
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_value
JWT_ALGORITHM=HS256
JWT_ISSUER=riskiq
JWT_AUDIENCE=riskiq-api
JWT_EXPIRY_SECONDS=3600

# Audience for GET /ws/feed's short-lived connection ticket (POST /auth/ws-ticket). Must
# differ from JWT_AUDIENCE above — a ticket that also validated against the REST audience
# would be a full-privilege bearer token riding in a URL query string, which is exactly what
# minting a separate ticket exists to avoid. The app refuses to start if the two are equal.
JWT_WS_AUDIENCE=riskiq-ws
WS_TICKET_EXPIRY_SECONDS=30

# HMAC key anonymizing Tier-3 ring entity ids at export time (app.models.tier3_graph). Without
# a real key here, the exported id is reversible: IEEE-CIS's shared-entity fingerprints draw
# from a small, public, enumerable domain, so an unkeyed hash is a dictionary attack away from
# the raw card/device fingerprint. Only read by the training script, never by the API server —
# but the app still refuses to start in staging/production while this is the placeholder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ENTITY_ANONYMIZATION_KEY=CHANGE_ME_generate_a_64_byte_random_value

# --- Webhooks ------------------------------------------------------------------
# Shared secret configured in the Razorpay dashboard's webhook settings for this endpoint.
# Must match exactly -- Razorpay signs X-Razorpay-Signature with it, and this app verifies
# against it. There is no other authentication on POST /webhooks/razorpay/transaction, so a
# placeholder here means the route accepts a signature anyone can forge. The app refuses to
# start in staging/production while this is still the placeholder value.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_paste_the_value_from_the_razorpay_dashboard

# --- Serving -----------------------------------------------------------------
# Root of the model tree: registry.json plus artifacts/. docker-compose sets this
# explicitly because the default is derived from the source layout, which is wrong inside
# the container. Weights are gitignored build outputs — a deployment must mount or bake
# them in, and /score returns 503 until it can load them.
# MODELS_DIR=/models

# Which corpus's models to serve. Only ieee_cis has a full stack.
SCORING_SOURCE_DATASET=ieee_cis

# Budget for the Tier-3 ring lookup. On expiry the decision is made without it and the
# audit row records degraded mode and the reason.
TIER3_TIMEOUT_MS=50

# Most recent prior transactions read per account when assembling serving features.
ACCOUNT_HISTORY_LIMIT=500

# --- CORS --------------------------------------------------------------------
# Exact origins only. These endpoints are credentialed, so '*' is refused at startup.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
